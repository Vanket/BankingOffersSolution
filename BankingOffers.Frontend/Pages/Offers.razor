@page "/offers"
@using BankingOffers.Frontend.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthState
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-10">
    <MudText Typo="Typo.h3" Class="mb-8" Style="font-weight: 700; color: #052767;">
        <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Large" Class="mr-2 mb-1" Color="Color.Primary" />
        Витрина предложений
    </MudText>

    @if (products == null)
    {
        <div class="d-flex justify-center align-center" style="height: 40vh;">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.h6" Color="Color.Secondary">Подбираем лучшие условия...</MudText>
            </MudStack>
        </div>
    }
    else if (products.Length == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="rounded-lg shadow-sm">
            Пока нет доступных предложений. Данные обновляются...
        </MudAlert>
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-4 rounded" />
    }
    else
    {
        <MudGrid Spacing="4">
            @foreach (var product in products)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Elevation="2" Class="h-100 d-flex flex-column modern-card rounded-xl pa-2">
        
                        <!-- ИСПРАВЛЕННАЯ ШАПКА КАРТОЧКИ -->
                        <div class="d-flex align-center px-4 pt-4 pb-2">
                            <!-- Аватар -->
                            <MudAvatar Size="Size.Large" Class="mr-3" Style="@($"background-color:{GetBankColor(product.BankName)}; color:white; font-weight:bold; box-shadow: 0 4px 10px {GetBankColor(product.BankName)}66;")">
                                @(product.BankName.Length > 0 ? product.BankName.Substring(0, 1) : "?")
                            </MudAvatar>
            
                            <!-- Текстовый блок (с защитой от переполнения) -->
                            <div class="flex-grow-1 overflow-hidden mr-2">
                                <MudText Typo="Typo.h6" Style="font-weight: 600; line-height: 1.2;" Class="text-truncate">
                                    @product.BankName
                                </MudText>
                                <!-- Магия CSS: текст занимает максимум 2 строки, лишнее обрезается троеточием -->
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.2; height: 2.4em; margin-top: 4px;">
                                    @product.ProductName
                                </MudText>
                            </div>

                            <!-- Иконка избранного (теперь всегда прижата вправо) -->
                            <div>
                                <MudIconButton Icon="@(favoriteIds.Contains(product.Id) ? Icons.Material.Filled.Favorite : Icons.Material.Filled.FavoriteBorder)"
                                               Color="Color.Error"
                                               OnClick="@(() => ToggleFavorite(product.Id))"
                                               Title="В избранное"
                                               Class="pa-1" />
                            </div>
                        </div>

                        <MudCardContent Class="flex-grow-1 pt-3">
                            <!-- ИСПРАВЛЕННЫЙ БЛОК С ЦИФРАМИ -->
                            <!-- Используем Grid, чтобы четко поделить пространство 50/50 -->
                            <MudGrid Spacing="1" AlignItems="AlignItems.Center" Class="mb-2">
                                <MudItem xs="6">
                                    <div class="rate-badge">
                                        <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.8); line-height: 1;">Ставка от</MudText>
                                        <MudText Typo="Typo.h5" Style="font-weight: 700; color: white; line-height: 1.2;">@product.InterestRate.ToString("0.##")%</MudText>
                                    </div>
                                </MudItem>
                                <MudItem xs="6" Class="d-flex flex-column align-end justify-center overflow-hidden">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="line-height: 1;">Сумма до</MudText>
                                    <MudText Typo="Typo.h6" Style="font-weight: 700; line-height: 1.2;" Class="text-truncate">@product.MaxAmount.ToString("N0") ₽</MudText>
                                </MudItem>
                            </MudGrid>

                            <MudDivider Class="my-3" />

                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.AccessTimeFilled" Size="Size.Small" Color="Color.Info" />
                                <MudText Typo="Typo.body2" Color="Color.Dark">
                                    Срок кредита: <b>до @(product.MaxTermInMonths / 12) лет</b>
                                </MudText>
                            </MudStack>
                        </MudCardContent>

                        <MudCardActions Class="pt-0 pb-3 px-4">
                            @{
                                var url = product.Url;
                                if (!string.IsNullOrEmpty(url) && !url.StartsWith("http"))
                                {
                                    if (product.BankName.Contains("ВТБ")) url = "https://www.vtb.ru" + url;
                                    else if (product.BankName.Contains("Сбер")) url = "https://www.sberbank.ru" + url;
                                    else if (product.BankName.Contains("Альфа")) url = "https://alfabank.ru" + url;
                                }
                            }

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       Href="@url"
                                       Target="_blank"
                                       Rel="noopener noreferrer"
                                       Disabled="@string.IsNullOrEmpty(url)"
                                       Class="rounded-pill py-2"
                                       Style="font-weight: 600;"
                                       EndIcon="@Icons.Material.Filled.ArrowForwardIos">
                                ОФОРМИТЬ
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

<style>
    .modern-card {
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        border: 1px solid #f0f0f0;
    }

        .modern-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.08) !important;
            border-color: #d1d9e6;
        }

    .rate-badge {
        background: linear-gradient(135deg, #052767 0%, #3a0647 100%);
        padding: 8px 16px;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(58, 6, 71, 0.2);
    }
</style>

@code {
    private LoanProduct[]? products;
    private HashSet<int> favoriteIds = new(); // Здесь храним ID лайкнутых продуктов для быстрого поиска
    private Timer? autoUpdateTimer;
    private bool isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        // Проверяем, вошел ли пользователь
        var state = await AuthState.GetAuthenticationStateAsync();
        isAuthenticated = state.User.Identity?.IsAuthenticated ?? false;

        await LoadData();

        // Автообновление каждые 15 секунд
        autoUpdateTimer = new Timer(async _ =>
        {
            await LoadProducts();
            await InvokeAsync(StateHasChanged);
        }, null, 15000, 15000);
    }

    private async Task LoadData()
    {
        await LoadProducts();

        // Если пользователь вошел, загружаем его лайки
        if (isAuthenticated)
        {
            try
            {
                var ids = await Http.GetFromJsonAsync<List<int>>("api/favorites/ids");
                if (ids != null) favoriteIds = ids.ToHashSet();
            }
            catch { }
        }
    }

    private async Task LoadProducts()
    {
        try
        {
            products = await Http.GetFromJsonAsync<LoanProduct[]>("api/products");
        }
        catch { }
    }

    private async Task ToggleFavorite(int productId)
    {
        if (!isAuthenticated)
        {
            Snackbar.Add("Чтобы добавить в избранное, нужно войти в систему!", Severity.Warning);
            return;
        }

        try
        {
            // Отправляем запрос на сервер
            var response = await Http.PostAsync($"api/favorites/toggle/{productId}", null);

            if (response.IsSuccessStatusCode)
            {
                // Если успешно, меняем состояние сердечка локально (чтобы не перезагружать всю страницу)
                if (favoriteIds.Contains(productId))
                {
                    favoriteIds.Remove(productId);
                    Snackbar.Add("Удалено из избранного", Severity.Normal);
                }
                else
                {
                    favoriteIds.Add(productId);
                    Snackbar.Add("Добавлено в избранное", Severity.Success);
                }
            }
        }
        catch
        {
            Snackbar.Add("Ошибка соединения с сервером", Severity.Error);
        }
    }

    private string GetBankColor(string bankName)
    {
        if (string.IsNullOrEmpty(bankName)) return "#757575";
        if (bankName.Contains("Сбер", StringComparison.OrdinalIgnoreCase)) return "#21a038";
        if (bankName.Contains("ВТБ", StringComparison.OrdinalIgnoreCase)) return "#002882";
        if (bankName.Contains("Альфа", StringComparison.OrdinalIgnoreCase)) return "#ef3124";
        if (bankName.Contains("Россельхоз", StringComparison.OrdinalIgnoreCase) || bankName.Contains("РСХБ")) return "#00aa00";
        return "#594ae2";
    }

    public void Dispose() => autoUpdateTimer?.Dispose();
}
{
  "AppSettings": {
    "Token": "my super secret key that must be very long for security reasons 12345"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=banking.db"
  },
  "ScrapingTargets": [
    {
      "BankName": "ВТБ",
      "Url": "https://www.vtb.ru/personal/kredit/",
      "Selectors": {
        // --- ГЛАВНОЕ ИСПРАВЛЕНИЕ ---
        // Мы ищем DIV, внутри которого есть ссылка (a), содержащая текст "Подробнее" (в любой глубине тегов)
        "ProductContainer": "//div[.//a[contains(., 'Подробнее')]]",

        // Название: Ищем ссылку, которая ведет на страницу кредита
        "ProductName": ".//a[contains(@href, '/personal/kredit/') and not(contains(., 'Подробнее'))]",

        // Ссылка: Кнопка, содержащая текст "Подробнее"
        "ProductUrl": ".//a[contains(., 'Подробнее')]",

        // Эти поля на главной странице ВТБ часто пустые или равны 0, поэтому оставляем пустыми
        // Данные будем брать на шаге 2 (внутри)
        "InterestRate": "",
        "MaxAmount": "",
        "MaxTerm": "",

        // --- ДЕТАЛЬНАЯ СТРАНИЦА (ВНУТРИ) ---
        // Эти селекторы мы уже отладили, они работают
        "DetailInterestRate": "//*[contains(text(), '%')]",
        "DetailMaxAmount": "//*[contains(text(), '₽') or contains(text(), 'руб') or contains(text(), 'сумма')]/ancestor::div[1]//*[contains(text(), '₽') or contains(text(), 'руб')]",
        "DetailMaxTerm": "//*[contains(text(), 'лет') or contains(text(), 'год')]",

        "AdditionalInfo": "",
        "DetailPageSelectors": {
          // Селектор вкладки, на которую надо кликнуть
          "TabButton": "//li[contains(., 'Ставки')]",
          // Селектор контейнера с цифрами (опционально, будем искать внутри всей страницы)
          "RatesContainer": ""
        }
      }
    },
    {
      "BankName": "СберБанк",
      "Url": "https://www.sberbank.ru/ru/person/credits/money",
      "Selectors": {
        // Ищем контейнер карточки по классу product-card__wrap
        "ProductContainer": "//div[contains(@class, 'product-card__wrap')]",

        // Ищем заголовок h2 с классом product-card__heading
        "ProductName": ".//h2[contains(@class, 'product-card__heading')]",

        // Ищем ссылку с классом product-card__link (это кнопка 'Подробнее' или 'Узнать больше')
        "ProductUrl": ".//a[contains(@class, 'product-card__link')]",
        // Остальные поля пустые, так как мы их парсим внутри, 
        // но добавим настройки для детальной страницы:
        "InterestRate": "",
        "MaxAmount": "",
        "MaxTerm": "",
        "DetailInterestRate": "",
        "DetailMaxAmount": "",
        "DetailMaxTerm": "",
        "AdditionalInfo": "",

        // НОВАЯ СЕКЦИЯ ДЛЯ КАЛЬКУЛЯТОРА
        "DetailPageSelectors": {
          "CalculatorContainer": "//div[contains(@class, 'credit-calc')]",
          "HiddenRate": ".//div[contains(@class, 'credit-calc__hidden-rate')]",

          // Берем первый найденный хендл (ползунок) - это Сумма
          "SliderAmount": "(.//div[contains(@class, 'dk-sbol-slider-track__handle')])[1]",

          // Берем второй найденный хендл - это Срок
          "SliderTerm": "(.//div[contains(@class, 'dk-sbol-slider-track__handle')])[2]"
        }
      }
    }
  ]
}